{
    "name": "mh-site",
    "version": "1.0.0",
    "license": "MIT",
    "type": "module",
    "devDependencies": {
        "@11ty/eleventy": "^3.1.8",
        "@11ty/eleventy-img": "^7.1.1",
        "@11ty/eleventy-navigation": "^1.0.5",
        "@11ty/eleventy-plugin-rss": "^3.1.0",
        "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
        "@11ty/eleventy-plugin-webc": "^0.11.2",
        "@netlify/plugin-lighthouse": "^6.0.4",
        "@tailwindcss/postcss": "^4.3.5",
        "@tailwindcss/typography": "^0.5.20",
        "@toycode/markdown-it-class": "^1.2.4",
        "cssnano": "^9.9.0",
        "dotenv": "^16.5.0",
        "eleventy-plugin-youtube-embed": "^1.13.2",
        "html-minifier-terser": "^7.2.0",
        "markdown-it": "^14.2.0",
        "markdown-it-abbr": "^2.0.0",
        "markdown-it-anchor": "^10.1.0",
        "markdown-it-attrs": "^5.0.1",
        "markdown-it-emoji": "^3.1.0",
        "markdown-it-link-attributes": "^4.0.1",
        "markdown-it-prism": "^4.0.0",
        "netlify-plugin-cache": "^1.0.3",
        "npm-run-all": "^4.1.5",
        "pirsch-sdk": "^2.10.1",
        "postcss": "^8.5.33",
        "postcss-cli": "^12.0.0",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.3.5",
        "tailwindcss-debug-screens": "^3.0.1"
    },
    "scripts": {
        "dev:twnd": "env postcss src/_css/tailwind.css -o dist/assets/css/theme.css --watch --verbose",
        "dev:11ty": "env eleventy --serve",
        "dev": "npm-run-all clean --parallel 'dev:*' --print-label",
        "build:twnd": "env ELEVENTY_ENV=production postcss src/_css/tailwind.css -o dist/assets/css/theme.css",
        "build:11ty": "env ELEVENTY_ENV=production eleventy",
        "build": "npm-run-all 'build:*' --print-label",
        "format": "prettier --write \"{src,content}/**/*.{js,json,css,md}\"",
        "test": "node --test",
        "clean": "rm -rf ./dist"
    },
    "dependencies": {
        "@11ty/is-land": "^5.3.0",
        "speedlify-score": "^4.0.5"
    },
    "packageManager": "yarn@3.6.1"
}
