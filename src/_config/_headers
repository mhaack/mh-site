# Fonts are versioned by filename (rename the file when changing it) -> cache for a year
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Optimized images from eleventy-img rarely change -> cache for a month
# (filenames are not content-hashed: rename the source image when replacing it)
/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

