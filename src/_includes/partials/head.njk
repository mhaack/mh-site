  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% if ignore -%}
    <meta name="robots" content="noindex">
    {% endif -%}
    <link rel="canonical" href="{{ page.url | url | absoluteUrl(site.url) }}">

    {#- OG image: one card page, cache key changes only with the card content -#}
    {%- set ogImgSrv = site.url + '/opengraph/' -%}
    {%- set ogKey = site.ogImageVersion ~ '|' ~ site.name -%}
    {%- set ogAlt = site.name -%}
    {%- if layout == 'post' -%}
      {%- set currentPage = collections.all | currentPage(page) -%}
      {%- set desc = currentPage.templateContent | safe | striptags | truncate(140) | escape -%}
      {%- set ogImgSrv = site.url + '/opengraph/?page=' + page.url -%}
      {%- set ogKey = site.ogImageVersion ~ '|' ~ title ~ '|' ~ (date | toIsoString) -%}
      {%- set ogAlt = title -%}
      {%- set keywords = tags -%}
    {%- endif %}
    {%- set ogImage -%}{% ogImageUrl ogImgSrv, ogKey %}{%- endset %}

    <title>{{ seo.title or title or site.name | escape }}</title>

    <link rel="preload" href="/assets/fonts/ibm-plex-sans-v21-latin-regular.woff2" as="font" type="font/woff2" crossorigin> 
    <link rel="preload" href="/assets/fonts/ibm-plex-sans-v21-latin-600.woff2" as="font" type="font/woff2" crossorigin> 
    <link rel="icon" href="/assets/icons/favicon.svg">
    <link rel="mask-icon" href="/assets/icons/favicon.svg" color="#000000">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png">
    <link rel="manifest" href="/assets/manifest.webmanifest">
    <link href="{{ '/assets/css/theme.css' | url }}" rel="stylesheet">
    <link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ site.name }}">
    <link rel="alternate" href="/feed/feed.json" type="application/json" title="{{ site.name }}">
    <link rel="webmention" href="https://webmention.io/markus-haack.com/webmention" />
    <link rel="author" href="/humans.txt">

    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">
    <meta name="description" content="{{ seo.description or description or desc or site.description }}">
    <meta name="keywords" content="{{ keywords or site.keywords }}">
    <meta name="author" content="{{ site.author.name }}">
    <meta name="generator" content="{{ eleventy.generator }}">

    <meta property="og:title" content="{{ seo.title or title or site.name | escape }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url + page.url }}">
    <meta property="og:description" content="{{ seo.description or description or desc or site.description }}">
    <meta property="og:image" content="{{ ogImage | safe }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ ogAlt | escape }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:creator" content="@{{ site.author.twitterHandle | replace('@', '') }}"/>
    <meta name="twitter:image" content="{{ ogImage | safe }}">
    <meta name="twitter:image:alt" content="{{ ogAlt | escape }}">

    {#- Run non-critical work only after first paint and load, when the browser is idle,
        so it never lands on the critical path (Lighthouse counts requests started before paint) -#}
    <script>
      window.afterPaint = (fn) => {
        let done = false;
        let painted = !(PerformanceObserver.supportedEntryTypes || []).includes('paint') || performance.getEntriesByName('first-contentful-paint').length > 0;
        let loaded = document.readyState === 'complete';
        const run = () => {
          if (done || !painted || !loaded) return;
          done = true;
          'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 3000 }) : setTimeout(fn, 200);
        };
        if (!painted) new PerformanceObserver((list, obs) => { if (list.getEntriesByName('first-contentful-paint').length) { obs.disconnect(); painted = true; run(); } }).observe({ type: 'paint', buffered: true });
        {#- Safety net: never wait on paint for more than 3s after load (e.g. a background tab) -#}
        const onLoad = () => { loaded = true; run(); setTimeout(() => { painted = true; run(); }, 3000); };
        loaded ? onLoad() : addEventListener('load', onLoad, { once: true });
      };
    </script>
    {% if env.isProd -%}
    <script>
      afterPaint(() => {
        const s = document.createElement('script');
        s.id = 'pianjs';
        s.src = 'https://p.markus-haack.org/assets/js/pa.js';
        s.dataset.hitEndpoint = 'https://p.markus-haack.org/pv';
        s.dataset.eventEndpoint = 'https://p.markus-haack.org/e';
        s.dataset.sessionEndpoint = 'https://p.markus-haack.org/s';
        document.head.appendChild(s);
      });
    </script>
    {%- endif %}
    {%- if layout == 'home' -%}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","url":"https://markus-haack.com/","name":"{{ site.name }}","description":"{{site.description }}"}</script>
    {%- endif %}
    {%- if layout == 'post' -%}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","@id":"{{ page.url | url | absoluteUrl(site.url) }}","headline":"{{ title | escape }}","image":"{{ ogImage | safe }}","datePublished":"{{ date | dateToRfc3339 }}","description":"{{ description or desc or site.description }}","keywords":"{{ keywords }}","author":{"@type":"Person","name":"{{ site.author.name }}", "url":"https://markus-haack.com/about/"}}</script>
    {%- endif %}
  </head>